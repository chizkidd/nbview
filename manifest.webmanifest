{
  "id": "/",
  "name": "nbview",
  "short_name": "nbview",
  "description": "Read Jupyter notebooks from any GitHub repo, in your browser.",
  "lang": "en",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#F6F7F9",
  "theme_color": "#2D52CF",
  "icons": [
    { "src": "/assets/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/assets/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/assets/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/assets/apple-touch-icon.png", "sizes": "180x180", "type": "image/png" }
  ],
  "screenshots": [
    { "src": "/assets/screenshots/home-narrow.png", "sizes": "864x1606", "type": "image/png", "form_factor": "narrow", "label": "Search a GitHub repo and open a notebook" }
  ]
}
