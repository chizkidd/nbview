/*
  Content-Security-Policy: default-src 'none'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src * data: blob:; media-src https: data: blob:; connect-src https:; form-action 'none'; base-uri 'none'; frame-ancestors 'none'; frame-src 'none'; object-src 'none'
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-Content-Type-Options: nosniff

# Lets exported .html files (opened from disk or another site) load the math and page fonts from here.
/assets/vendor/katex/fonts/*
  Access-Control-Allow-Origin: *

/assets/fonts/*
  Access-Control-Allow-Origin: *
