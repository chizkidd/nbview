/*
  Content-Security-Policy: default-src 'none'; script-src 'self' https://nbview.org https://static.cloudflareinsights.com; worker-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src * data: blob:; manifest-src 'self'; media-src https: data: blob:; connect-src https:; form-action 'none'; base-uri 'none'; frame-ancestors 'self'; frame-src 'self'; object-src 'none'
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-Content-Type-Options: nosniff

# Lets exported .html files (opened from disk or another site) load the math and page fonts from here.
/assets/vendor/katex/fonts/*
  Access-Control-Allow-Origin: *

/assets/fonts/*
  Access-Control-Allow-Origin: *

/manifest.webmanifest
  Content-Type: application/manifest+json

# Cache-Control is deliberately absent for assets. Cloudflare Pages sends its own
# `public, max-age=14400, must-revalidate` for /assets/** and /sw.js and ignores a value set here
# (checked against production with a fresh cache key, so it is not a stale edge copy). Freshness
# therefore comes from the ?v= content hash stamped into index.html: a deploy changes the URL, and
# no cache can ignore that. The worker needs no rule either, because browsers bypass the HTTP cache
# when they check a worker script for an update, so a new policy is picked up on the next load.
